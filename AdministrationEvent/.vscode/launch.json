{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar web (.NET 10)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Compilar web",
      "program": "${workspaceFolder}/bin/Debug/net10.0/AdministrationEvent.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5088"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "launchSettingsProfile": ""
    }
  ]
}
