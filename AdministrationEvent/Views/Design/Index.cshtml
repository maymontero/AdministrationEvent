@model InvitationConfiguration
@{ ViewData["Title"]="Editor visual"; }
<link rel="stylesheet" href="~/css/design-editor.css" asp-append-version="true" />
<div id="design-editor" data-url="/design/@Model.Id" data-version="@ViewData["Version"]" data-date="@Model.Date?.ToString("yyyy-MM-ddTHH:mm:ss")">
@Html.AntiForgeryToken()
<script type="application/json" id="design-data">@Html.Raw((string)ViewData["Document"])</script>
<div class="design-heading"><div><span class="eyebrow">@Model.Title</span><h1>Tu tarjeta, a tu manera</h1></div><div class="actions"><button id="design-undo" type="button">Deshacer</button><button id="design-redo" type="button">Rehacer</button><button class="button" id="design-save" type="button">Guardar borrador</button><a id="design-preview" href="/design/@Model.Id/preview" target="_blank" rel="noopener">Vista previa ↗</a></div></div>
<p id="design-status" role="status" aria-live="polite">Seleccioná una sección y empezá a diseñar.</p>
<p class="design-small">El editor está pensado para iPad y computadora (pantallas desde 768 px).</p>
<div class="design-layout">
<aside class="design-sidebar"><h2>Secciones</h2><div id="design-sections"></div><button id="add-section" type="button">+ Nueva sección</button><button id="design-blank" type="button">Empezar en blanco</button><div class="design-section-actions"><button id="section-up" type="button">↑ Subir</button><button id="section-down" type="button">↓ Bajar</button><button id="section-copy" type="button">Duplicar</button><button id="section-remove" type="button">Eliminar sección</button></div><hr/>
<label>Nombre de la sección<input id="section-name" maxlength="80" /></label><label>Alto de la sección<input id="section-height" type="number" min="200" max="2400" step="50" /></label><label>Color de fondo<input id="section-bg" type="color" /></label><label>Imagen de fondo<select id="section-image"></select></label><hr/>
<h2>Agregar</h2><div class="design-add">@foreach(var type in new[] {"title:Título","text:Texto","image:Imagen","button:Botón","countdown:Cuenta regresiva"}) { var parts=type.Split(':'); <button type="button" data-add="@parts[0]">+ @parts[1]</button> }</div>
<label>Subir imagen<input id="design-upload" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /></label><small>Hasta 10 MB. Guardá el diseño después de agregarla.</small>
@if(User.IsInRole("Owner")){<hr/><details><summary>Usar este diseño en la invitación</summary><p>Guardar conserva un borrador. Aplicar reemplaza la presentación actual, conservando los datos y el diseño anterior.</p><button id="design-activate" type="button">Aplicar diseño guardado</button><button id="design-deactivate" type="button">Volver al diseño anterior</button></details>}
</aside>
<section class="design-stage-panel" aria-label="Lienzo de la invitación"><div class="design-stage-bar"><span>Lienzo · 900 px</span><span>Arrastrá para mover · esquina para ajustar</span></div><div id="design-stage"></div></section>
<aside class="design-inspector"><h2>Elemento</h2><p id="no-element">Tocá un título, texto o imagen para editarlo.</p><div id="element-properties" hidden>
<label>Texto<textarea id="element-text" rows="4" maxlength="5000"></textarea></label><label>Imagen<select id="element-image"></select></label><label>Enlace del botón<input id="element-link" type="url" placeholder="https://…" /></label><div class="design-font-picker"><span id="font-label">Tipografía</span><select id="element-font" hidden aria-label="Tipografía"></select><button id="font-picker-toggle" type="button" aria-expanded="false" aria-controls="font-picker-panel"><span id="font-current-name">Elegir tipografía</span><span id="font-current-sample" aria-hidden="true">Aa · Nos casamos</span></button><div id="font-picker-panel" hidden><label>Buscar tipografía<input id="font-search" type="search" placeholder="Nombre de la letra…" /></label><div id="font-samples" role="group" aria-label="Tipografías disponibles"></div><p id="font-results" role="status"></p></div></div><label>Tamaño de letra<input id="element-size" type="number" min="10" max="160" /></label><label>Color de letra<input id="element-color" type="color" /></label><label>Color del botón<input id="element-bg" type="color" /></label><label>Alineación<select id="element-align"><option value="left">Izquierda</option><option value="center">Centro</option><option value="right">Derecha</option></select></label>
<div class="design-geometry"><label>X (%)<input id="element-x" type="number" min="0" max="97" step="0.5" /></label><label>Y (px)<input id="element-y" type="number" min="0" /></label><label>Ancho (%)<input id="element-width" type="number" min="3" max="100" step="0.5" /></label><label>Alto (px)<input id="element-height" type="number" min="20" /></label></div>
<label>Mover a sección<select id="element-section"></select></label><div class="design-element-actions"><button id="element-front" type="button">Traer delante</button><button id="element-back" type="button">Enviar atrás</button><button id="element-copy" type="button">Duplicar elemento</button><button id="element-remove" type="button">Eliminar elemento</button></div></div></aside>
</div></div>
@section Scripts {<script src="~/js/canvas-renderer.js" asp-append-version="true" defer></script><script src="~/js/design-editor.js" asp-append-version="true" defer></script>}
