@model InvitationConfiguration
@{
    string trackId = null;
    if (Uri.TryCreate(Model.Theme.SpotifyTrackUrl, UriKind.Absolute, out var uri) && uri.Scheme == "https" && uri.Host == "open.spotify.com" && string.IsNullOrEmpty(uri.UserInfo)) {
        var match = System.Text.RegularExpressions.Regex.Match(uri.AbsolutePath, "^/(?:embed/)?track/([a-zA-Z0-9]{22})/?$");
        if (match.Success) trackId = match.Groups[1].Value;
    }
}
@if(trackId != null) {
<section class="invitation-song" id="cancion" data-spotify-music data-track="@trackId" aria-labelledby="song-title">
    <div class="background-music">
        <button class="background-music-toggle" data-spotify-toggle type="button" hidden aria-pressed="false">♫ Reproducir</button>
    </div>
    <span class="song-ornament" aria-hidden="true">♫</span>
    <h2 id="song-title">Un brindis con música</h2>
    <p class="song-intro">Una canción para acompañar este momento.</p>
    <div class="song-player" data-spotify-panel>
        <div data-spotify-embed>
            <iframe class="invitation-spotify" src="https://open.spotify.com/embed/track/@(trackId)?utm_source=generator&amp;theme=0" width="100%" height="152" title="Música de la invitación en Spotify" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="eager" allowfullscreen></iframe>
        </div>
        <p class="visually-hidden song-status" data-spotify-status role="status" aria-live="polite"></p>
    </div>
</section>
}
