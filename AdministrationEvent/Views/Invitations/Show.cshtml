@model InvitationConfiguration
@using System.Globalization
@using System.Linq
@{
    Layout = null;
    var t = Model.Theme;
    var vineyard = t.Layout == "vineyard";
    var preview = ViewData["Preview"] != null;
    var headingFont = string.IsNullOrEmpty(t.HeadingFontUrl) ? t.HeadingFont : "InvitationHeading";
    var bodyFont = string.IsNullOrEmpty(t.BodyFontUrl) ? t.BodyFont : "InvitationBody";
    var culture = new CultureInfo("es-UY");
    var detailTitles = new[] { "Niños", "Regalos", "Dress code" };
    var details = vineyard ? Model.Sections.Where(x => x.Enabled && (detailTitles.Contains(x.Title) || (x.ImageUrl == "/images/zenia-diego/regalos-acuarela.png" || x.ImageUrl == "/images/zenia-diego/regalos-estilo-sagrada-familia-v2.png"))).ToList() : new System.Collections.Generic.List<AdministrationEvent.Models.InvitationSection>();
    var blocks = Model.Sections.Where(x => x.Enabled && (!vineyard || !(detailTitles.Contains(x.Title) || (x.ImageUrl == "/images/zenia-diego/regalos-acuarela.png" || x.ImageUrl == "/images/zenia-diego/regalos-estilo-sagrada-familia-v2.png")))).ToList();
    var form = ViewData["RsvpForm"] as RsvpForm ?? new RsvpForm();
}
@if(t.Layout == "relaxed") { <partial name="_Relaxed" model="Model" /> } else {
<!DOCTYPE html>
<html lang="es"><head><link rel="icon" type="image/svg+xml" href="~/favicon-zd.svg" asp-append-version="true" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@Model.Title</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/invitation.css" asp-append-version="true" />
<script src="~/js/invitation.js" asp-append-version="true" defer></script>
<style>
@if(!string.IsNullOrEmpty(t.HeadingFontUrl)) { <text>@@font-face { font-family: InvitationHeading; src: url('@t.HeadingFontUrl'); font-display: swap; }</text> }
@if(!string.IsNullOrEmpty(t.BodyFontUrl)) { <text>@@font-face { font-family: InvitationBody; src: url('@t.BodyFontUrl'); font-display: swap; }</text> }
</style></head>
<body class="invitation @(vineyard ? "vineyard" : "classic")" style="--background:@t.Background;--ink:@t.Text;--accent:@t.Accent;--secondary:@t.Secondary;--highlight:@t.Highlight;--heading:@headingFont;--body:@bodyFont;--radius:@(t.CornerRadius)px;--size:@(t.FontSize)px;--width:@(t.ContentWidth)px;">
@if(preview) { <div class="preview-banner">Vista previa · @(Model.IsPublished ? "Publicada" : "Borrador") <a href="/admin/edit/@Model.Id">Volver a configurar</a></div> }
@if(vineyard) { <nav class="wedding-nav" aria-label="Secciones de la invitación"><a class="nav-signature" href="#inicio">@Model.Hosts</a><div><a href="#detalles">El encuentro</a>@if(Model.RsvpEnabled) { <a href="#asistencia">Confirmar asistencia</a> }</div></nav> }
<main class="invitation-content" id="inicio">
<section class="invitation-hero @(vineyard && !string.IsNullOrEmpty(Model.CoverImageUrl) ? "has-cover" : "")">
@if(!vineyard) { <span class="eyebrow">@Model.EventType</span> }<div class="ornament" aria-hidden="true">✧</div>
<h1>@Model.Hosts</h1><p class="message">@Model.Message</p>
@if(Model.Date.HasValue) { <p class="event-date">@Model.Date.Value.ToString(Model.HasConfirmedTime ? "dddd d 'de' MMMM 'de' yyyy · HH:mm" : "dddd d 'de' MMMM 'de' yyyy", culture)</p> }
@if(Model.RsvpEnabled) { <a class="hero-link" href="#asistencia">Compartí este día con nosotros
@if(!vineyard) { <span aria-hidden="true">↓</span> }</a> }
@if(!string.IsNullOrEmpty(Model.CoverImageUrl)) { <img class="cover" src="@Model.CoverImageUrl" alt="@Model.Title" fetchpriority="high" /> }
</section>
@if(Model.ShowCountdown && Model.Date.HasValue) {
<section class="countdown-band" aria-label="Cuenta regresiva">
<span class="eyebrow">Cada día, un poquito más cerca</span>
<div class="countdown" data-days-only="@vineyard.ToString().ToLowerInvariant()" data-date="@Model.Date.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-zone="@Model.TimeZone" data-confirmed="@Model.HasConfirmedTime.ToString().ToLowerInvariant()" data-target="@(new DateTimeOffset(DateTime.SpecifyKind(Model.Date.Value, DateTimeKind.Unspecified), TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZone).GetUtcOffset(DateTime.SpecifyKind(Model.Date.Value, DateTimeKind.Unspecified))).ToString("o", CultureInfo.InvariantCulture))">
<div><strong data-days>—</strong><span>días</span></div>
@if(Model.HasConfirmedTime && !vineyard) { <div><strong data-hours>—</strong><span>horas</span></div><div><strong data-minutes>—</strong><span>minutos</span></div> }
</div><p data-countdown-caption>Para celebrar juntos</p><noscript>Nos encontramos el @Model.Date.Value.ToString("d 'de' MMMM 'de' yyyy", culture).</noscript>
</section> }
<div class="invitation-sections" id="detalles">
@for(var i = 0; i < blocks.Count; i++) { var block = blocks[i];
<section class="invitation-section @(!string.IsNullOrEmpty(block.ImageUrl) ? "with-image" : "text-only") @(vineyard && block.Title == "Celebración" && !string.IsNullOrEmpty(block.ImageUrl) ? "celebration-backdrop" : "")">
@if(!string.IsNullOrEmpty(block.ImageUrl)) { <div class="section-art"><img src="@block.ImageUrl" alt="@block.Title" loading="lazy" /></div> }
<div class="section-copy">@if(vineyard) { <span class="section-number" aria-hidden="true">@((i + 1).ToString("00")) <span></span></span> }
<h2 style="@(block.TitleFontSize.HasValue ? $"font-size:{block.TitleFontSize.Value}px" : null)">@block.Title</h2>
@if(vineyard && !string.IsNullOrEmpty(block.LinkUrl)) {
    var lines = block.Content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
    <div class="event-information">@for(var line = 0; line < lines.Length; line++) {
        <p class="@(line == lines.Length - 1 ? "event-address" : line == lines.Length - 2 ? "event-venue" : line == 0 && lines.Length > 3 ? "event-context" : "event-schedule")">@lines[line]</p>
    }</div>
} else { <p>@block.Content</p> }
@if(!string.IsNullOrEmpty(block.LinkUrl)) { <a class="button" href="@block.LinkUrl" target="_blank" rel="noopener noreferrer">@if(vineyard) { <svg width="20" height="24" viewBox="0 0 24 28" fill="none" aria-hidden="true"><path d="M12 26s10-10.3 10-16A10 10 0 0 0 2 10c0 5.7 10 16 10 16Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="3.5" stroke="currentColor" stroke-width="1.6"/></svg><span>¿Cómo ir?</span> } else { <text>@block.LinkLabel ↗</text> }</a> }
</div></section> }
</div>
@if(details.Any()) {
<section class="other-details" id="otros-detalles" aria-labelledby="other-details-title">@if(details.Count == 1 && !string.IsNullOrEmpty(details[0].ImageUrl)) { <img class="gift-heading-art" src="@details[0].ImageUrl" alt="" loading="lazy" /> }<h2 id="other-details-title" style="@(details.Count == 1 && details[0].TitleFontSize.HasValue ? $"font-size:{details[0].TitleFontSize.Value}px" : null)">@(details.Count == 1 ? details[0].Title : "Otros detalles")</h2><div class="other-details-grid">
@foreach(var detail in details) { <article>@if(details.Count > 1 && !string.IsNullOrEmpty(detail.ImageUrl)) { <img class="detail-vignette" src="@detail.ImageUrl" alt="" loading="lazy" /> }@if(details.Count > 1) { <h3 style="@(detail.TitleFontSize.HasValue ? $"font-size:{detail.TitleFontSize.Value}px" : null)">@detail.Title</h3> }<p>@(System.Text.RegularExpressions.Regex.Replace(detail.Content ?? "", @"(Si (?:quieres|querés|queres) hacernos llegar algo más)\s*:", "$1", System.Text.RegularExpressions.RegexOptions.IgnoreCase))</p>@if(!string.IsNullOrEmpty(detail.LinkUrl)) { <a href="@detail.LinkUrl" target="_blank" rel="noopener noreferrer">@detail.LinkLabel ↗</a> }</article> }
</div></section>
}
@if(Model.RsvpEnabled) { <partial name="_Rsvp" model="Model" /> }
<partial name="_SpotifyMusic" model="Model" />
<footer class="invitation-footer"><span aria-hidden="true">✧</span><p>@Model.Hosts</p>@if(Model.Date.HasValue) { <small>@Model.Date.Value.ToString("dd · MM · yyyy")</small> }</footer>
</main></body></html>

}
