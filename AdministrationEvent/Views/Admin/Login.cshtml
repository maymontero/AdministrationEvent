@{ ViewData["Title"] = "Acceso administrativo"; }
<section class="panel login"><span class="eyebrow">TU ESPACIO</span><h1>Administrar invitaciones</h1><div asp-validation-summary="All" class="errors"></div>
@if (!(bool)ViewData["Configured"]) { <p>Para habilitar el acceso, configurá la variable de entorno <code>Admin__Password</code> en el servidor y reiniciá la aplicación.</p> }
else { <form method="post" action="/admin/login">@Html.AntiForgeryToken()<label for="password">Contraseña</label><input id="password" type="password" name="password" autocomplete="current-password" required /><button class="button">Ingresar →</button></form> }</section>
