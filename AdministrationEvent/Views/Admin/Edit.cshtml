@model InvitationEditor
@{ ViewData["Title"] = "Configurar invitación"; }
<a href="/admin">← Mis invitaciones</a>
<div class="page-heading"><div><span class="eyebrow">TU EVENTO, TU ESTILO</span><h1>Configurar invitación</h1><p>Hacé los cambios cotidianos desde esta pantalla. La configuración avanzada queda disponible al final.</p></div>@if(ViewData["New"] == null) { <a href="/admin/preview/@Model.Id" target="_blank" rel="noopener">Vista previa guardada ↗</a> }</div>
@if(TempData["Success"] != null) { <p class="success" role="status">@TempData["Success"]</p> }
<form class="editor-form" method="post" action="/admin/edit/@Model.Id" data-invitation-editor>
@Html.AntiForgeryToken()<div asp-validation-summary="All" class="errors"></div>
<textarea asp-for="ConfigurationJson" class="json-editor" spellcheck="false" hidden></textarea>
<section class="panel editor-card"><div class="editor-card-heading"><div><span class="eyebrow">LO ESENCIAL</span><h2>La invitación</h2></div><label class="switch"><input type="checkbox" data-field="IsPublished"><span></span><b>Publicada</b></label></div>
<div class="editor-grid editor-grid-2"><label>Nombre interno<input data-field="Title" maxlength="120"></label><label>Enlace público<input data-field="Slug" maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*"><small>Solo minúsculas, números y guiones.</small></label><label>Tipo de evento<input data-field="EventType" maxlength="80"></label><label>Fecha y hora<input data-field="Date" type="datetime-local"><small>Dejalo vacío si aún no la definiste.</small></label><label class="wide">Protagonistas / título de portada<textarea data-field="Hosts" rows="2" maxlength="200"></textarea></label><label class="wide">Mensaje de bienvenida<textarea data-field="Message" rows="3" maxlength="2000"></textarea></label><label class="wide">Imagen de portada<input data-field="CoverImageUrl" placeholder="/images/... o https://..."><button type="button" class="asset-trigger" data-image-target="cover">Elegir o subir imagen</button></label></div>
<div class="editor-options"><label class="check"><input type="checkbox" data-field="HasConfirmedTime"> Hora confirmada</label><label class="check"><input type="checkbox" data-field="ShowCountdown"> Mostrar cuenta regresiva</label><label class="check"><input type="checkbox" data-field="RsvpEnabled"> Activar confirmación de asistencia</label></div><div class="sharing-control"><label>Acceso al publicar<select data-field="SharingMode"><option value="public">Público: cualquiera con el enlace corto puede verla</option><option value="link">Privado: solo quien tenga el enlace privado puede verla</option></select></label><div data-sharing-link></div></div></section>

<section class="panel editor-card"><div class="editor-card-heading"><div><span class="eyebrow">CONTENIDO</span><h2>Secciones</h2><p>Arrastrá para cambiar el orden. Cada bloque se puede ocultar, editar o eliminar.</p></div><button type="button" class="quiet-button" data-add-section>+ Agregar sección</button></div><div class="sections-editor" data-sections></div></section>

<section class="panel editor-card"><div class="editor-card-heading"><div><span class="eyebrow">ESTILO GENERAL</span><h2>Colores, tipografía y música</h2></div></div><div class="free-layout" data-layout-status></div><div class="editor-grid editor-grid-3"><label>Fuente de títulos<input data-field="Theme.HeadingFont" maxlength="120" readonly><button type="button" class="asset-trigger" data-font-target="heading">Elegir una tipografía</button></label><label>Fuente de texto<input data-field="Theme.BodyFont" maxlength="120" readonly><button type="button" class="asset-trigger" data-font-target="body">Elegir una tipografía</button></label><label>Playlist de Spotify<input data-field="Theme.SpotifyTrackUrl" type="url" placeholder="https://open.spotify.com/playlist/..."></label></div>
<div class="color-editor"><label>Fondo<input data-color="Theme.Background" type="color"></label><label>Texto<input data-color="Theme.Text" type="color"></label><label>Principal<input data-color="Theme.Accent" type="color"></label><label>Secundario<input data-color="Theme.Secondary" type="color"></label><label>Detalle<input data-color="Theme.Highlight" type="color"></label></div></section>

<details class="panel advanced-editor"><summary>Configuración avanzada (JSON)</summary><p>Para ajustes excepcionales. Para los cambios normales usá los controles de arriba.</p><textarea class="json-editor json-editor-advanced" spellcheck="false" data-advanced-json></textarea></details>
<div class="editor-actions"><button class="button" data-save-once>Guardar cambios</button>@if(ViewData["New"] == null) { <a class="button button-secondary" href="/admin/preview/@Model.Id" target="_blank" rel="noopener">Ver vista previa</a> }</div>
</form>
<template id="section-template"><article class="section-editor" draggable="true"><header><button type="button" class="drag-handle" aria-label="Mover sección">⠿</button><strong data-section-name>Nueva sección</strong><label class="check compact"><input type="checkbox" data-section="Enabled"> Visible</label><button type="button" class="icon-button" data-remove-section aria-label="Eliminar sección">×</button></header><div class="editor-grid editor-grid-2"><label>Título<input data-section="Title" maxlength="120"></label><label>Tratamiento visual<select data-section="DisplayMode"><option value="standard">Imagen debajo del texto</option><option value="art-above">Dibujo pequeño sobre el título</option><option value="backdrop">Imagen como fondo de sección</option></select></label><label class="wide">Texto<textarea data-section="Content" rows="4" maxlength="5000"></textarea></label><label>Imagen<input data-section="ImageUrl" placeholder="/images/... o https://..."><button type="button" class="asset-trigger" data-image-target="section">Elegir o subir imagen</button></label><label>Tamaño de título (opcional)<input data-section="TitleFontSize" type="number" min="16" max="80" placeholder="Automático"></label><label>Texto del enlace<input data-section="LinkLabel" maxlength="80" placeholder="Ver más"></label><label>Enlace<input data-section="LinkUrl" type="url" placeholder="https://..."></label></div></article></template>
<dialog class="asset-dialog" data-asset-dialog><header><h2 data-asset-title>Elegir recurso</h2><button type="button" class="icon-button" data-close-assets aria-label="Cerrar">×</button></header><div data-asset-content></div><form method="dialog" data-upload-form><label>Subir una imagen<input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-upload-file></label><button class="quiet-button">Subir y usar</button></form></dialog>
@section Scripts { <script src="~/js/invitation-editor.js" asp-append-version="true"></script> }
