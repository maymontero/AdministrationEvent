@model InvitationListPage
@{ ViewData["Title"] = "Mis invitaciones"; }
<div class="page-heading invitation-list-heading"><div><span class="eyebrow">PANEL ADMINISTRATIVO</span><h1>Invitaciones</h1><p>Buscá una invitación y abrí su menú para administrarla.</p></div><a class="button" href="/admin/new">+ Nueva invitación</a></div>
@if(TempData["Success"] != null) { <p class="success" role="status">@TempData["Success"]</p> }
@if(TempData["Error"] != null) { <p class="errors" role="alert">@TempData["Error"]</p> }
<form class="invitation-list-filters" method="get" action="/admin" role="search"><div><label for="invitation-search">Buscar invitaciones</label><input id="invitation-search" name="search" value="@Model.Search" type="search" maxlength="120" placeholder="Nombre, protagonistas o tipo" /></div><div><label for="invitation-status">Estado</label><select id="invitation-status" name="status"><option value="all" selected="@(Model.Status == "all")">Todas</option><option value="draft" selected="@(Model.Status == "draft")">Borradores</option><option value="published" selected="@(Model.Status == "published")">Publicadas</option></select></div><button type="submit" class="button">Buscar</button>@if(Model.Search.Length > 0 || Model.Status != "all") { <a href="/admin">Limpiar filtros</a> }</form>
<p class="invitation-list-count" role="status">@Model.Total @(Model.Total == 1 ? "invitación" : "invitaciones")@if(Model.Total > Model.PageSize) { <span> · Mostrando @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.Total))</span> }</p>
@if(Model.Items.Count == 0) {
<div class="panel invitation-list-empty"><h2>@(Model.Search.Length > 0 || Model.Status != "all" ? "No encontramos invitaciones" : "Todavía no hay invitaciones")</h2><p>@(Model.Search.Length > 0 || Model.Status != "all" ? "Probá con otro nombre o cambiá los filtros." : "Creá la primera invitación para empezar.")</p></div>
} else {
<div class="invitation-list"><table><caption class="sr-only">Lista de invitaciones y sus acciones</caption><thead><tr><th scope="col">Nombre</th><th class="invitation-meta-column" scope="col">Fecha</th><th class="invitation-meta-column" scope="col">Tipo</th><th class="invitation-meta-column" scope="col">Estado</th><th scope="col" class="invitation-actions-heading"><span class="sr-only">Acciones</span></th></tr></thead><tbody>
@foreach(var item in Model.Items) {
    var shareUrl = item.SharingMode == "link" && !string.IsNullOrEmpty(item.ShareKey) ? "/" + item.Slug + "/acceso/" + item.ShareKey : "/" + item.Slug;
    var state = item.IsPublished ? (item.SharingMode == "link" ? "Enlace privado" : "Pública") : "Borrador";
<tr><th scope="row" class="invitation-name"><a href="/admin/edit/@item.Id">@item.Title</a><div class="invitation-mobile-meta"><span>@(item.Date?.ToString("dd/MM/yyyy") ?? "Sin fecha")</span><span>@item.EventType</span><span>@state</span></div></th>
<td class="invitation-meta-column invitation-date">@(item.Date?.ToString("dd/MM/yyyy") ?? "Sin fecha")</td><td class="invitation-meta-column">@item.EventType</td><td class="invitation-meta-column"><span class="invitation-state @(item.IsPublished ? "published" : "draft")">@state</span></td>
<td class="invitation-actions-cell"><details class="invitation-actions-menu"><summary aria-label="Acciones de @item.Title" title="Acciones de @item.Title"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg></summary><nav class="invitation-row-menu" aria-label="Acciones de @item.Title">
<a href="/admin/edit/@item.Id">Configurar</a><a href="/design/@item.Id">Editor visual</a>@if(item.RsvpEnabled) { <a href="/admin/guests/@item.Id">Invitados y asistencia</a> }@if(item.SeatingPlanEnabled) { <a href="/admin/guests/@item.Id/plan">Plano de mesas</a> }<a href="/admin/preview/@item.Id" target="_blank" rel="noopener">Vista previa ↗</a>@if(item.IsPublished) { <a href="@shareUrl" target="_blank" rel="noopener">@(item.SharingMode == "link" ? "Abrir enlace privado ↗" : "Abrir invitación ↗")</a> }<a class="invitation-delete" href="/admin/delete/@item.Id">Eliminar invitación</a>
</nav></details></td></tr>
}
</tbody></table></div>
}
@if(Model.PageCount > 1) {
<nav class="invitation-pagination" aria-label="Páginas de invitaciones">@if(Model.Page > 1) { <a href="@Url.Action("Index", new { search = Model.Search, status = Model.Status, page = Model.Page - 1 })">← Anterior</a> }<span>Página @Model.Page de @Model.PageCount</span>@if(Model.Page < Model.PageCount) { <a href="@Url.Action("Index", new { search = Model.Search, status = Model.Status, page = Model.Page + 1 })">Siguiente →</a> }</nav>
}
<form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button class="quiet">Cerrar sesión</button></form>
