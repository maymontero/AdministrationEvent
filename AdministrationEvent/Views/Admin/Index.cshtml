@model List<InvitationConfiguration>
@{ ViewData["Title"] = "Mis invitaciones"; }
<div class="page-heading"><div><span class="eyebrow">PANEL ADMINISTRATIVO</span><h1>Mis invitaciones</h1><p>Un lugar para dar forma a cada celebración.</p></div><a class="button" href="/admin/new">+ Nueva invitación</a></div>
<div class="cards">@foreach(var item in Model) { <article class="panel"><span class="eyebrow">@item.EventType · @(item.IsPublished ? "Publicada" : "Borrador")</span><h2>@item.Title</h2><p>@item.Hosts</p><p>@item.Date?.ToString("dd/MM/yyyy")</p><div class="actions"><a class="button" href="/admin/edit/@item.Id">Configurar</a>@if(item.RsvpEnabled) { <a href="/admin/responses/@item.Id">Asistencias</a> }<a href="/admin/preview/@item.Id">Vista previa ↗</a>@if(item.IsPublished) { <a href="/invitacion/@item.Slug">Ver pública ↗</a> }</div></article> }</div>
<form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button class="quiet">Cerrar sesión</button></form>
