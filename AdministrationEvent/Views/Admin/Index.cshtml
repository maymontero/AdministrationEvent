@model List<InvitationConfiguration>
@{ ViewData["Title"] = "Mis invitaciones"; }
<div class="page-heading"><div><span class="eyebrow">PANEL ADMINISTRATIVO</span><h1>Cada detalle de nuestro día</h1><p>Bienvenida, @User.Identity.Name. Prepará las invitaciones y acompañá cada confirmación.</p></div><a class="button" href="/admin/new">+ Nueva invitación</a></div>
@if(TempData["Success"] != null) { <p class="success" role="status">@TempData["Success"]</p> }
@if(TempData["Error"] != null) { <p class="errors" role="alert">@TempData["Error"]</p> }
<div class="cards">@foreach(var item in Model) { var shareUrl = item.SharingMode == "link" && !string.IsNullOrEmpty(item.ShareKey) ? "/" + item.Slug + "/acceso/" + item.ShareKey : "/" + item.Slug; <article class="panel"><span class="eyebrow">@item.EventType · @(item.IsPublished ? (item.SharingMode == "link" ? "Enlace privado" : "Pública") : "Borrador")</span><h2>@item.Title</h2><p>@item.Hosts</p><p>@item.Date?.ToString("dd/MM/yyyy")</p><div class="actions"><a class="button" href="/admin/edit/@item.Id">Configurar</a>@if(item.RsvpEnabled) { <a href="/admin/guests/@item.Id">Invitados y asistencia</a> }<a href="/admin/preview/@item.Id">Vista previa ↗</a>@if(item.IsPublished) { <a href="@shareUrl">@(item.SharingMode == "link" ? "Abrir enlace privado ↗" : "Abrir invitación ↗")</a> }<a href="/admin/delete/@item.Id">Eliminar invitación</a></div></article> }</div>
<form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button class="quiet">Cerrar sesión</button></form>
