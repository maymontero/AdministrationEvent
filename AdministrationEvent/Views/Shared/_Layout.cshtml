<!DOCTYPE html>
<html lang="es"><head><link rel="icon" type="image/svg+xml" href="~/favicon-zd.svg" asp-append-version="true" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Zenia &amp; Diego</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /><script src="~/js/admin.js" asp-append-version="true" defer></script></head>
<body class="celebration-admin"><header class="topbar"><a class="brand" href="/">Zenia &amp; Diego<span>CADA DETALLE, CON AMOR</span></a><nav class="admin-nav" aria-label="Administración"><a href="/admin">Invitaciones</a>@if(User.Identity?.IsAuthenticated == true) { @if(User.IsInRole("Owner")) { <a href="/admin/accounts">Cuentas</a> }<a href="/admin/accounts/password">Mi cuenta</a><span class="admin-name">@User.Identity.Name</span> }</nav></header><main class="shell">@RenderBody()</main><footer class="site-footer">Con cariño, para un día que vamos a recordar.</footer>@RenderSection("Scripts", required: false)</body></html>
