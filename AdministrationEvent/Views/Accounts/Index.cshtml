@model AccountPage
@{ ViewData["Title"] = "Cuentas y accesos"; }
<div class="page-heading"><div><span class="eyebrow">TU ADMINISTRACIÓN</span><h1>Cuentas y accesos</h1><p>Cada persona tiene su propio ingreso. Vos conservás el control de las cuentas.</p></div></div>
@if(TempData["Success"] != null) { <p class="success" role="status">@TempData["Success"]</p> }
@if(TempData["Error"] != null) { <p class="errors" role="alert">@TempData["Error"]</p> }
<div class="account-layout"><section class="panel"><h2>Crear cuenta</h2><form method="post" action="/admin/accounts/create">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="errors"></div>
<label for="account-name">Nombre</label><input id="account-name" name="DisplayName" value="@Model.Editor.DisplayName" maxlength="100" required />
<label for="account-user">Usuario</label><input id="account-user" name="Username" value="@Model.Editor.Username" pattern="[a-zA-Z0-9._-]{3,40}" autocomplete="off" required />
<label for="account-password">Contraseña inicial</label><input id="account-password" name="Password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
<p class="account-hint">Al menos 12 caracteres. Solo verá las invitaciones que le habilites.</p><button class="button">Crear cuenta</button></form></section>
<section class="account-list">@foreach(var user in Model.Users) { <article class="panel"><span class="eyebrow">@(user.IsOwner ? "Administradora principal" : "Acceso a invitaciones")</span><h2>@user.DisplayName</h2><p>@user.Username · @(user.IsActive ? "Activa" : "Desactivada")</p>
@if(!user.IsOwner) {
<h3>Invitaciones permitidas</h3><p class="account-hint">Sin marcar: sin acceso. Una fecha futura habilita el acceso automáticamente (hora de Uruguay). Los borradores siguen ocultos.</p>
@foreach(var invitation in Model.Invitations) {
    var access = Model.Accesses.FirstOrDefault(x => x.UserId == user.Id && x.InvitationId == invitation.Id);
    var localDate = access?.AvailableFromUtc is System.DateTime utc ? System.TimeZoneInfo.ConvertTimeFromUtc(System.DateTime.SpecifyKind(utc, System.DateTimeKind.Utc), System.TimeZoneInfo.FindSystemTimeZoneById("America/Montevideo")).ToString("yyyy-MM-ddTHH:mm") : "";
    <form method="post" action="/admin/accounts/access/@user.Id" class="permission-form">@Html.AntiForgeryToken()
    <input type="hidden" name="invitationId" value="@invitation.Id" />
    <label><input type="checkbox" name="enabled" value="true" checked="@(access != null)" /> @invitation.Title @(invitation.IsPublished ? "" : "(borrador)")</label>
    <label for="from-@user.Id-@invitation.Id">Disponible desde (opcional)</label><input id="from-@user.Id-@invitation.Id" type="datetime-local" name="availableFrom" value="@localDate" />
    <button class="quiet">Guardar permiso</button></form>
}
 <form method="post" action="/admin/accounts/toggle/@user.Id">@Html.AntiForgeryToken()<button class="quiet">@(user.IsActive ? "Desactivar acceso" : "Activar acceso")</button></form><details><summary>Restablecer contraseña</summary><form method="post" action="/admin/accounts/reset/@user.Id">@Html.AntiForgeryToken()<label for="reset-@user.Id">Nueva contraseña</label><input id="reset-@user.Id" type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password" required /><button class="button">Guardar contraseña</button></form></details> }
</article> }</section></div>
