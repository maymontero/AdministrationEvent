@model ChangeAccountPassword
@{ ViewData["Title"] = "Cambiar contraseña"; }
<section class="panel login"><span class="eyebrow">TU CUENTA</span><h1>Cambiar contraseña</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="errors"></div>
<label for="current">Contraseña actual</label><input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required />
<label for="new">Nueva contraseña</label><input id="new" name="NewPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
<label for="confirm">Confirmar nueva contraseña</label><input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" required /><button class="button">Guardar contraseña</button></form></section>
