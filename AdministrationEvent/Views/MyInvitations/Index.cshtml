@inject AdministrationEvent.Services.InvitationPermissions Permissions
@model System.Collections.Generic.List<InvitationConfiguration>
@{ ViewData["Title"] = "Mis invitaciones"; }

<h1>Mis invitaciones</h1>

@if(Model.Count == 0) {
    <p>Todavía no tenés invitaciones disponibles. Cuando te habiliten el acceso, las vas a encontrar acá.</p> }

@foreach(var invitation in Model) {
    <article class="panel">
        <h2>@invitation.Title</h2>
        @if(Permissions.CanDesign(User, invitation.Id, System.DateTime.UtcNow)) { <a class="button" href="/design/@invitation.Id">Diseñar mi tarjeta</a> }
        <a class="button" href="/admin/preview/@invitation.Id">Ver vista previa →</a>
    </article> }
<form method="post" action="/admin/logout">
    @Html.AntiForgeryToken()
    <button class="quiet">Cerrar sesión</button>
</form>
